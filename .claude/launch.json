{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "./gradlew",
      "runtimeArgs": [
        "bootRun",
        "--args=--spring.profiles.active=local"
      ],
      "port": 8080,
      "cwd": "airral-backend"
    },
    {
      "name": "website",
      "runtimeExecutable": "node_modules/.bin/nx",
      "runtimeArgs": [
        "serve",
        "website",
        "--host=localhost",
        "--port=4200"
      ],
      "port": 4200,
      "cwd": "airral-frontend"
    },
    {
      "name": "admin-portal",
      "runtimeExecutable": "node_modules/.bin/nx",
      "runtimeArgs": [
        "serve",
        "admin-portal",
        "--host=localhost",
        "--port=4203"
      ],
      "port": 4203,
      "cwd": "airral-frontend"
    },
    {
      "name": "applicant-portal",
      "runtimeExecutable": "node_modules/.bin/nx",
      "runtimeArgs": [
        "serve",
        "applicant-portal",
        "--host=localhost",
        "--port=4201"
      ],
      "port": 4201,
      "cwd": "airral-frontend"
    },
    {
      "name": "cictus-website",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "const h=require('http'),f=require('fs'),p=require('path'),t={'.html':'text/html','.css':'text/css','.js':'text/javascript','.svg':'image/svg+xml'};h.createServer((q,r)=>{let u=decodeURIComponent(q.url.split('?')[0]);if(u.endsWith('/'))u+='index.html';f.readFile(p.join('.',u),(e,b)=>{if(e){r.writeHead(404);return r.end()}r.writeHead(200,{'content-type':t[p.extname(u)]||'application/octet-stream'});r.end(b)})}).listen(4210)"
      ],
      "port": 4210,
      "cwd": "cictus-website/site"
    }
  ]
}
