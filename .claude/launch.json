{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "./gradlew",
      "runtimeArgs": [
        "bootRun",
        "--args=--spring.profiles.active=local"
      ],
      "port": 8080,
      "cwd": "airral-backend"
    },
    {
      "name": "website",
      "runtimeExecutable": "node_modules/.bin/nx",
      "runtimeArgs": [
        "serve",
        "website",
        "--host=localhost",
        "--port=4200"
      ],
      "port": 4200,
      "cwd": "airral-frontend"
    },
    {
      "name": "admin-portal",
      "runtimeExecutable": "node_modules/.bin/nx",
      "runtimeArgs": [
        "serve",
        "admin-portal",
        "--host=localhost",
        "--port=4203"
      ],
      "port": 4203,
      "cwd": "airral-frontend"
    },
    {
      "name": "applicant-portal",
      "runtimeExecutable": "node_modules/.bin/nx",
      "runtimeArgs": [
        "serve",
        "applicant-portal",
        "--host=localhost",
        "--port=4201"
      ],
      "port": 4201,
      "cwd": "airral-frontend"
    }
  ]
}
