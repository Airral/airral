# Rendered by the nginx image's envsubst entrypoint, which substitutes ${PORT}.
# Cloud Run injects PORT and requires the container to listen on exactly it.
server {
    listen       ${PORT};
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    gzip              on;
    gzip_vary         on;
    gzip_proxied      any;
    gzip_comp_level   6;
    gzip_min_length   1024;
    gzip_types        text/plain text/css text/xml application/javascript
                      application/json image/svg+xml font/woff font/woff2;

    # Angular emits content-hashed filenames, so these can never go stale.
    location ~* "^.+\.[0-9a-zA-Z]{8,}\.(js|css|woff2?|png|jpe?g|gif|svg|webp|ico)$" {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # The shell and the runtime config change on every deploy and must not be
    # cached, or a browser keeps calling the previous environment's API.
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }
    location = /runtime-config.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # Client-side routing: unknown paths are Angular routes, not 404s.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
